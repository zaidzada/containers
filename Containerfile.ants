# ANTs (official pre-built Linux binaries)

FROM docker.io/library/ubuntu:24.04

ARG ANTS_VERSION=2.6.5
ARG DEBIAN_FRONTEND=noninteractive

# --- System packages + ANTs release zip ----------------------------------
# lib/ only holds static archives, so it's dropped to save space
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl unzip \
        bc libgomp1 \
    && curl -fL --retry 3 -o /tmp/ants.zip \
        "https://github.com/ANTsX/ANTs/releases/download/v${ANTS_VERSION}/ants-${ANTS_VERSION}-ubuntu-24.04-X64-gcc.zip" \
    && unzip -q /tmp/ants.zip -d /opt \
    && mv "/opt/ants-${ANTS_VERSION}" /opt/ants \
    && rm -rf /opt/ants/lib /tmp/ants.zip /var/lib/apt/lists/* \
    && apt-get purge -y --auto-remove unzip

# ANTSPATH is used by the bundled scripts (e.g. antsRegistrationSyN.sh)
ENV ANTSPATH=/opt/ants/bin/ \
    PATH=/opt/ants/bin:$PATH

WORKDIR /work
CMD ["bash"]
