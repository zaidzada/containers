# pycortex

ARG BASE_IMAGE=localhost/freesurfer:8.2.0
FROM ${BASE_IMAGE}

ARG PYCORTEX_VERSION=1.4.0
ARG DEBIAN_FRONTEND=noninteractive

# --- System packages (for building pycortex and drawing overlays) ---------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        python3 python3-dev python3-venv \
        inkscape \
    && rm -rf /var/lib/apt/lists/*

# --- Python: pycortex + IPython in a venv ---------------------------------
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    MPLBACKEND=Agg
RUN python3 -m venv $VIRTUAL_ENV \
    && pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir numpy cython \
    && pip install --no-cache-dir "pycortex==${PYCORTEX_VERSION}" ipython

# --- Config ---------------------------------------------------------------
# pycortex: point the filestore at the mounted volume; no browser in here
RUN mkdir -p /data/pycortex-db /root/.config/pycortex \
    && printf '[basic]\nfilestore = /data/pycortex-db\n\n[webshow]\nopen_browser = false\n' \
        > /root/.config/pycortex/options.cfg

EXPOSE 8900
# Load FreeSurfer, then put the venv back first on PATH (SetUpFreeSurfer.sh
# prepends FreeSurfer's bundled python), then exec the given command.
ENTRYPOINT ["bash", "-c", "source \"$FREESURFER_HOME/SetUpFreeSurfer.sh\" >/dev/null && export PATH=\"$VIRTUAL_ENV/bin:$PATH\" && exec \"$@\"", "--"]
CMD ["ipython", "-i", "-c", "import numpy as np; import cortex"]
